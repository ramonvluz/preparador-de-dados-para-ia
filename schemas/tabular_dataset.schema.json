{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preparador-dados.local/schemas/tabular_dataset-1.0.json",
  "title": "Preparador Tabular Dataset",
  "type": "object",
  "required": ["schema_version", "record_type", "record_id", "source", "data", "processing"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "tabular_dataset" },
    "record_id": { "type": "string", "pattern": "^tabular_[a-f0-9]{24}$" },
    "source": {
      "type": "object",
      "required": ["file_name", "file_type", "size_bytes"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "file_type": { "const": "csv" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["encoding", "dialect", "dataset"],
      "properties": {
        "encoding": { "type": "string", "minLength": 1 },
        "dialect": { "$ref": "#/$defs/dialect" },
        "dataset": {
          "allOf": [
            { "$ref": "#/$defs/dataset" },
            {
              "properties": {
                "source_kind": { "const": "csv" },
                "reference": { "type": "null" }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "processing": {
      "type": "object",
      "required": [
        "converted_at",
        "unicode_cleaned",
        "warnings",
        "header_inferred",
        "ragged_rows",
        "blank_rows_skipped",
        "type_inference_sample_size"
      ],
      "properties": {
        "converted_at": { "type": "string", "format": "date-time" },
        "unicode_cleaned": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "header_inferred": { "type": "boolean" },
        "ragged_rows": { "type": "integer", "minimum": 0 },
        "blank_rows_skipped": { "type": "integer", "minimum": 0 },
        "type_inference_sample_size": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "dialect": {
      "type": "object",
      "required": ["delimiter", "quote_character", "escape_character", "line_terminator"],
      "properties": {
        "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
        "quote_character": { "type": "string", "minLength": 1, "maxLength": 1 },
        "escape_character": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 1 },
            { "type": "null" }
          ]
        },
        "line_terminator": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": ["index", "name", "source_name", "inferred_type", "nullable"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source_name": { "type": ["string", "null"] },
        "inferred_type": {
          "enum": ["empty", "boolean", "integer", "number", "date", "datetime", "time", "string", "mixed"]
        },
        "nullable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["name", "source_kind", "reference", "has_header", "columns", "total_rows", "row_start", "row_end", "rows"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["csv", "worksheet_range", "excel_table"] },
        "reference": { "type": ["string", "null"] },
        "has_header": { "type": "boolean" },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column" } },
        "total_rows": { "type": "integer", "minimum": 0 },
        "row_start": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "row_end": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": ["string", "number", "boolean", "null"] }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
