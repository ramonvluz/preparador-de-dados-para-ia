{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preparador-dados.local/schemas/spreadsheet_workbook-1.0.json",
  "title": "Preparador Spreadsheet Workbook",
  "type": "object",
  "required": ["schema_version", "record_type", "record_id", "source", "data", "processing"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "spreadsheet_workbook" },
    "record_id": { "type": "string", "pattern": "^spreadsheet_[a-f0-9]{24}$" },
    "source": {
      "type": "object",
      "required": ["file_name", "file_type", "size_bytes"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "file_type": { "const": "xlsx" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["workbook", "sheet", "dataset", "formulas"],
      "properties": {
        "workbook": {
          "type": "object",
          "required": ["sheet_count"],
          "properties": { "sheet_count": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        },
        "sheet": { "$ref": "#/$defs/sheet" },
        "dataset": { "$ref": "#/$defs/dataset" },
        "formulas": { "type": "array", "items": { "$ref": "#/$defs/formula" } }
      },
      "additionalProperties": false
    },
    "processing": {
      "type": "object",
      "required": ["converted_at", "unicode_cleaned", "warnings", "formula_policy", "formula_cells", "merged_ranges", "hidden_rows", "hidden_columns", "external_links_followed"],
      "properties": {
        "converted_at": { "type": "string", "format": "date-time" },
        "unicode_cleaned": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "formula_policy": { "const": "cached_value_with_formula_metadata" },
        "formula_cells": { "type": "integer", "minimum": 0 },
        "merged_ranges": { "type": "integer", "minimum": 0 },
        "hidden_rows": { "type": "integer", "minimum": 0 },
        "hidden_columns": { "type": "integer", "minimum": 0 },
        "external_links_followed": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sheet": {
      "type": "object",
      "required": ["index", "name", "visibility", "used_range"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "visibility": { "enum": ["visible", "hidden", "very_hidden"] },
        "used_range": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": ["index", "name", "source_name", "inferred_type", "nullable"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source_name": { "type": ["string", "null"] },
        "inferred_type": {
          "enum": ["empty", "boolean", "integer", "number", "date", "datetime", "time", "string", "mixed"]
        },
        "nullable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["name", "source_kind", "reference", "has_header", "columns", "total_rows", "row_start", "row_end", "rows"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["worksheet_range", "excel_table"] },
        "reference": { "type": "string", "minLength": 1 },
        "has_header": { "type": "boolean" },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column" } },
        "total_rows": { "type": "integer", "minimum": 0 },
        "row_start": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "row_end": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": ["string", "number", "boolean", "null"] }
          }
        }
      },
      "additionalProperties": false
    },
    "formula": {
      "type": "object",
      "required": ["cell_reference", "formula", "cached_value"],
      "properties": {
        "cell_reference": { "type": "string", "minLength": 1 },
        "formula": { "type": "string", "pattern": "^=" },
        "cached_value": { "type": ["string", "number", "boolean", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
